# Database
DATABASE_URL=sqlite:///./data/gantry.db

# Authentication
# Leave blank to have the backend generate a random key in data/.secret_key (0600).
# If you set it, use a random 32+ character value (e.g. `openssl rand -hex 32`); never commit it.
SECRET_KEY=
SESSION_EXPIRE_HOURS=24

# ChromaDB (vector memory)
NEBULUS_CHROMA_URL=http://chromadb:8000  # was CHROMA_HOST

# LLM inference (OpenAI-compatible endpoint)
NEBULUS_LLM_URL=http://tabby:5000  # was TABBY_HOST

# Frontend (used in docker-compose for Vite)
VITE_API_URL=http://localhost:8000

# Citations: drop retrieved chunks below this similarity. Set 0 to disable. Under
# docker-compose a blank or unset value uses the compose default 0.42 (${VAR:-0.42});
# outside compose, blank means off. 0.42 is the value
# calibrated on the synthetic CPA demo corpus with Chroma's default embedding; recalibrate
# for your corpus with scripts/cpa_demo_smoke.py calibrate.
GANTRY_MIN_SOURCE_SIMILARITY=0.42
# Bounded lexical boost for exact-term near-misses (e.g. "Whitfield AGI" at 0.3986).
# Does not change the floor. Set GANTRY_KEYWORD_BOOST=off to disable.
# GANTRY_KEYWORD_BOOST=on
# GANTRY_KEYWORD_BOOST_MAX=0.05
# GANTRY_KEYWORD_BOOST_WINDOW=0.06
# GANTRY_KEYWORD_BOOST_MIN_SCORE=0.5
# Set true only if the model's chat template prefills <think> (only </think> is emitted).
GANTRY_REASONING_PREFILLED=false

# Docker network (override for non-Prime deployments)
# NEBULUS_NETWORK=nebulus-prime_ai-network
